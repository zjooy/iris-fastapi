# Copie este arquivo para ".env" e ajuste os valores conforme necessário.
# Nunca commite o arquivo ".env" real (já está no .gitignore).

APP_NAME="API de Classificação de Espécies de Flores Iris"
ENVIRONMENT=development

# CORS - lista separada por vírgula, ex: '["https://meusite.com"]'
CORS_ALLOW_ORIGINS=["*"]

# JWT - GERE UM VALOR PRÓPRIO EM PRODUÇÃO, por exemplo com:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev-secret-key-troque-em-producao-nunca-versione-o-real
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Usuário mockado (não há banco de dados de usuários nesta API)
MOCK_USERNAME=demo
# Hash bcrypt correspondente à senha "demo123" (ver README para gerar outro)
MOCK_PASSWORD_HASH=$2b$12$KenabROLW1iOYIlJ.jv8Z.7sNNFMGPoag8BjKeolERHMQR3nGSVn2

# Observabilidade
LOG_LEVEL=INFO
LOG_JSON=true
METRICS_ENABLED=true
